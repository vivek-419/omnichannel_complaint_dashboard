# ==============================================================================
# CCMRS Environment Configuration Template
# Copy this file to .env and fill in the values: cp .env.example .env
# ==============================================================================

# Server Port
PORT=5001

# PostgreSQL Database Configuration
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/ccmrs_db
# Cloud PostgreSQL (Railway/RDS): postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password@your_host.proxy.rlwy.net:PORT/railway
PGHOST=your_host.proxy.rlwy.net
PGPORT=5432
PGDATABASE=railway
PGUSER=postgres
PGPASSWORD=your_password
DATABASE_SSL=false

# Telegram Bot API Token (Obtain from @BotFather)
TELEGRAM_BOT_TOKEN=

# Discord Bot API Token (Obtain from Discord Developer Portal)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# AI NLP Engine (Google Gemini API Key)
GEMINI_API_KEY=

# SMTP Mailer Settings (Optional: for outgoing supervisor email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
